*%*ImageableArea EnvKaku2/Envelope Kaku2:			"12.0 12.0 668.0 929.0"
*%*ImageableArea EnvKaku3/Envelope Kaku3:			"12.0 12.0 600.0 773.0"
*%*ImageableArea EnvKaku6/Envelope Kaku6:			"12.0 12.0 447.0 638.0"
*%*ImageableArea Postcard/Postcard:			"12.0 12.0 272.0 408.0"
*%*ImageableArea PostcardD/Double Postcard:		"12.0 12.0 408.0 556.0"
*%*ImageableArea PostcardF/4-Postcard Printed Sheet:	"12.0 12.0 555.0 827.0"
*?ImageableArea: "
	save
	/cvp { (                ) cvs print ( ) print } bind def
	/upperright {10000 mul floor 10000 div} bind def
	/lowerleft {10000 mul ceiling 10000 div} bind def
	newpath clippath pathbbox
	4 -2 roll exch 2 {lowerleft cvp} repeat
	exch 2 {upperright cvp} repeat flush
	restore"
*End

