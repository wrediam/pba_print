# Copy this to .env and fill in real values before running
# `docker compose up` with docker-compose.yml (the production stack).

# --- Postgres ---
POSTGRES_USER=pba_print
POSTGRES_PASSWORD=change-me
POSTGRES_DB=pba_print

# --- App ---
# How this app will actually be reached -- SvelteKit needs this to know
# its own origin for CSRF-safe form submissions. Use the LAN
# hostname/IP/Coolify domain this ends up running behind.
ORIGIN=http://printer-dashboard.local:3000
APP_PORT=3000

# --- Printer ---
PRINTER_HOST=192.168.1.222
PRINTER_ADMIN_PASSWORD=admin

# --- Dashboard login (the one secretary account) ---
# Only used the very first time the app starts with an empty admin_user
# table -- changing these later does NOT reset an existing password.
ADMIN_USERNAME=secretary
ADMIN_PASSWORD=change-me

# --- Sync ---
# How often (seconds) to automatically pull new usage from the printer's
# Job Log in the background, in addition to the manual "Sync Now" button.
# Incremental syncs are fast (they stop as soon as they reach jobs
# already imported), so a short interval like this is fine.
SYNC_INTERVAL_SECONDS=30

# --- Print gateway (optional) ---
# See gateway/README.md and docs/GATEWAY_MIGRATION.md. If unset, this
# app just doesn't offer gateway-queue provisioning (/api/gateway/provision
# returns 503) -- everything else works the same. Once the gateway
# service in compose.yaml is running, set GATEWAY_URL to reach it (the
# compose service name, "http://gateway:8631", if deploying both
# together) and GATEWAY_SHARED_SECRET to the same value configured on
# the gateway service itself.
GATEWAY_URL=http://gateway:8631
GATEWAY_SHARED_SECRET=change-me-gateway-secret
